{
  "name": "numara",
  "productName": "Numara",
  "description": "Numara Calculator",
  "version": "8.1.0",
  "author": {
    "name": "Timur Atalay",
    "email": "mail@numara.io",
    "url": "https://numara.io"
  },
  "license": "MIT",
  "homepage": "https://github.com/bornova/numara-calculator",
  "main": "src/electron/main.js",
  "desktopName": "numara.desktop",
  "type": "module",
  "scripts": {
    "prebuild": "npm run prettier && npm run lint",
    "build": "node build.js",
    "dist": "npm run prebuild && node build.js --prod && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "publish": "npm run prebuild && node build.js --prod && electron-builder --x64 --arm64 -p always -c.forceCodeSigning=true",
    "start": "npm run build && electron .",
    "test": "node --test tests/numara-tests.js tests/combinatorial-tests.js tests/e2e-tests.js",
    "test:unit": "node --test tests/numara-tests.js tests/combinatorial-tests.js",
    "test:e2e": "node --test tests/e2e-tests.js",
    "wiki": "node src/misc/wiki.js"
  },
  "devDependencies": {
    "@bornova/colorpicker": "^1.1.0",
    "@bornova/deep-diff": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@formulajs/formulajs": "^4.6.1",
    "codemirror": "^5.65.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "function-plot": "^1.26.0",
    "globals": "^17.14.0",
    "lucide": "^1.79.0",
    "luxon": "^3.7.2",
    "mathjs": "^15.3.0",
    "nerdamer-prime": "^1.5.0",
    "prettier": "^3.10.1",
    "uikit": "^3.25.31"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true
  }
}
